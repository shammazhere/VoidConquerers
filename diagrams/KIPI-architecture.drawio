<diagram id="page2" name="3. Low-Level: Compaction, File Format, Memory">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="&lt;b&gt;Low-Level: Compaction, On-Disk Format and In-Memory State&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=24;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1600" height="40" as="geometry"/></mxCell>
<mxCell id="cc" value="COMPACTION  ·  src/kvdb/compact.go  (under the write lock)" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="700" height="1025" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;1. Projected size&lt;/b&gt; = 16 + live bytes + 12 ≤ max-bytes?  else ERR DISK_FULL, nothing touched" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="420" height="64" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;2. Create db.kv.tmp&lt;/b&gt; (O_EXCL) and write the header" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="420" height="64" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;3. Copy every live record&lt;/b&gt; in file-offset order; verify each CRC on the way" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="420" height="64" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;4. Write one marker&lt;/b&gt; for all of them" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="420" height="64" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;5. fsync db.kv.tmp&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="420" height="64" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;6. rename(db.kv.tmp → db.kv)&lt;/b&gt;: atomic, old file or new file, never a mix" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffe6cc;fillStyle=solid;strokeColor=#d79b00;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="570" width="420" height="64" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;7. Switch&lt;/b&gt;: POSIX keeps the tmp descriptor (now db.kv); Windows closes, renames, reopens · point the index at the new offsets" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="660" width="420" height="64" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;8. fsync the directory&lt;/b&gt; so the rename survives a power cut" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="750" width="420" height="64" as="geometry"/></mxCell>
<mxCell id="cp11" value="CP11 halfway through copy → old file, tmp deleted" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="300" width="210" height="44" as="geometry"/></mxCell>
<mxCell id="cp12" value="CP12 tmp synced → old file, tmp deleted" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="480" width="210" height="44" as="geometry"/></mxCell>
<mxCell id="cp13" value="CP13 after rename → new file" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="570" width="210" height="44" as="geometry"/></mxCell>
<mxCell id="cwhy" value="&lt;b&gt;Why it cannot lose data&lt;/b&gt;&lt;br&gt;open() always trusts db.kv and deletes any db.kv.tmp. Crash before the rename = compaction never happened. Crash after it = compaction finished. There is never a moment with zero valid copies." style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffffff;fillStyle=solid;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="860" width="650" height="120" as="geometry"/></mxCell>
<mxCell id="cwhen" value="&lt;b&gt;When it runs&lt;/b&gt;: the COMPACT command · disk-full guard · automatically when dead &gt; max(1 MiB, live) or the database is empty (1M keys deleted: 85 MB → 28 bytes)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffffff;fillStyle=solid;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="995" width="650" height="90" as="geometry"/></mxCell>
<mxCell id="cf" value="ON-DISK FORMAT  ·  db.kv  (binary, little-endian, append-only)" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffe6cc;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="75" width="880" height="640" as="geometry"/></mxCell>
