<mxfile host="app.diagrams.net" type="device">
<diagram id="page0" name="1. High-Level Architecture">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="&lt;b&gt;KIPI Key-Value Database: High-Level Architecture&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=24;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1300" height="40" as="geometry"/></mxCell>
<mxCell id="st" value="One Go binary (kvdb) holds the CLI, the server and the storage engine. A separate binary (torture) attacks it and checks every acknowledged write." style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="24" as="geometry"/></mxCell>
<mxCell id="c_clients" value="CLIENTS" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#e1d5e7;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1620" height="210" as="geometry"/></mxCell>
<mxCell id="user" value="&lt;b&gt;Judge / user&lt;/b&gt;&lt;br&gt;terminal: types commands" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#e1d5e7;fillStyle=solid;strokeColor=#9673a6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="c_tort" value="Torture tool  (./torture)   ·   every iteration: start serve → send ops → kill mid-operation → recover → verify → repeat" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#e1d5e7;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="118" width="1300" height="165" as="geometry"/></mxCell>
<mxCell id="ver" value="&lt;b&gt;Verifier&lt;/b&gt;&lt;br&gt;runs open → check → dump, compares every key with the oracle" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#e1d5e7;fillStyle=solid;strokeColor=#9673a6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="158" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="gen" value="&lt;b&gt;Workload generator&lt;/b&gt;&lt;br&gt;random PUT / DEL / BATCH / COMPACT from 2 concurrent lanes, seeded" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#e1d5e7;fillStyle=solid;strokeColor=#9673a6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="158" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="orc" value="&lt;b&gt;Oracle&lt;/b&gt;&lt;br&gt;trusts only ACKs; an un-ACKed op may be all there or all gone" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#e1d5e7;fillStyle=solid;strokeColor=#9673a6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="158" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="kill" value="&lt;b&gt;Killer&lt;/b&gt;&lt;br&gt;SIGKILL at a random ms, or --crash-at CPn at an exact line" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#e1d5e7;fillStyle=solid;strokeColor=#9673a6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="158" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="modes" value="&lt;b&gt;Modes&lt;/b&gt;&lt;br&gt;default · large-values · large-batches · compaction · recovery-crash · disk-full · d2-same-key · &lt;b&gt;crash-points&lt;/b&gt; · &lt;b&gt;scale&lt;/b&gt; (1M keys)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#e1d5e7;fillStyle=solid;strokeColor=#9673a6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1320" y="158" width="300" height="105" as="geometry"/></mxCell>
<mxCell id="c_if" value="INTERFACE LAYER  (cmd/kvdb)" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1620" height="135" as="geometry"/></mxCell>
<mxCell id="cli" value="&lt;b&gt;kvdb CLI&lt;/b&gt;&lt;br&gt;open · put · get · del · batch · dump · check&lt;br&gt;each command opens (= recovers), works, closes; prints time, accepted / rejected + reason" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="445" width="640" height="82" as="geometry"/></mxCell>
<mxCell id="serve" value="&lt;b&gt;kvdb serve&lt;/b&gt;  (one request per line on stdin, one reply on stdout)&lt;br&gt;lanes: op-id prefix before &#x27;_&#x27; → in order within a lane, concurrent across lanes&lt;br&gt;ACK printed inside the commit, after fsync #2 · ERR with a code · STATS" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="800" y="445" width="830" height="82" as="geometry"/></mxCell>
<mxCell id="c_eng" value="STORAGE ENGINE  (src/kvdb, Go standard library only)" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1620" height="280" as="geometry"/></mxCell>
<mxCell id="wp" value="&lt;b&gt;Write path&lt;/b&gt; (Apply)&lt;br&gt;records → fsync → marker → fsync → index → ACK" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="630" width="245" height="85" as="geometry"/></mxCell>
<mxCell id="rp" value="&lt;b&gt;Read path&lt;/b&gt; (Get)&lt;br&gt;index lookup → pread → CRC check" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="335" y="630" width="245" height="85" as="geometry"/></mxCell>
<mxCell id="rec" value="&lt;b&gt;Recovery&lt;/b&gt; (Open)&lt;br&gt;scan, commit on marker, cut torn tail" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="630" width="245" height="85" as="geometry"/></mxCell>
<mxCell id="cmp" value="&lt;b&gt;Compaction&lt;/b&gt;&lt;br&gt;copy live → tmp → fsync → atomic rename" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="865" y="630" width="245" height="85" as="geometry"/></mxCell>
<mxCell id="dfg" value="&lt;b&gt;Disk-full guard&lt;/b&gt;&lt;br&gt;reject before writing; 1/8 kept for deletes" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1130" y="630" width="245" height="85" as="geometry"/></mxCell>
<mxCell id="chk" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;read-only full scan; never repairs" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1395" y="630" width="245" height="85" as="geometry"/></mxCell>
<mxCell id="idx" value="&lt;b&gt;In-memory index (RAM)&lt;/b&gt;&lt;br&gt;key → (offset, size) of its latest record&lt;br&gt;values stay on disk · rebuilt by recovery at every open" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="745" width="510" height="100" as="geometry"/></mxCell>
<mxCell id="conc" value="&lt;b&gt;Concurrency&lt;/b&gt;&lt;br&gt;RWMutex: one writer at a time, readers share&lt;br&gt;OS file lock: one process per database (DB_LOCKED)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="745" width="510" height="100" as="geometry"/></mxCell>
<mxCell id="cps" value="&lt;b&gt;14 crash points&lt;/b&gt;  (// CPn - CRASH HERE)&lt;br&gt;--crash-at CPn kills the process at that exact line&lt;br&gt;CP1–7 write · CP8–10, 14 recovery · CP11–13 compaction" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1130" y="745" width="500" height="100" as="geometry"/></mxCell>
<mxCell id="c_os" value="OPERATING SYSTEM" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f5f5f5;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="1620" height="115" as="geometry"/></mxCell>
<mxCell id="pc" value="&lt;b&gt;Page cache (RAM)&lt;/b&gt;: pwrite lands here first&lt;br&gt;survives kill -9 · lost on a power cut → that is why we fsync" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f5f5f5;fillStyle=solid;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="950" width="700" height="62" as="geometry"/></mxCell>
<mxCell id="sys" value="&lt;b&gt;System calls&lt;/b&gt;&lt;br&gt;fsync · ftruncate · rename · flock / LockFileEx" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f5f5f5;fillStyle=solid;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="950" width="400" height="62" as="geometry"/></mxCell>
<mxCell id="sig" value="&lt;b&gt;Process kill&lt;/b&gt; (SIGKILL / TerminateProcess)&lt;br&gt;no cleanup code runs" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f5f5f5;fillStyle=solid;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1270" y="950" width="360" height="62" as="geometry"/></mxCell>
<mxCell id="c_disk" value="DISK" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffe6cc;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="1620" height="105" as="geometry"/></mxCell>
<mxCell id="dbkv" value="&lt;b&gt;db.kv&lt;/b&gt;: append-only binary log&lt;br&gt;16-byte header · records · commit markers" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffe6cc;fillStyle=solid;strokeColor=#d79b00;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="1103" width="700" height="58" as="geometry"/></mxCell>
<mxCell id="tmp" value="&lt;b&gt;db.kv.tmp&lt;/b&gt; while compacting / creating&lt;br&gt;&lt;b&gt;db.kv.rejected-*&lt;/b&gt; cut tails, inspection only" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffe6cc;fillStyle=solid;strokeColor=#d79b00;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="1103" width="400" height="58" as="geometry"/></mxCell>
<mxCell id="lck" value="&lt;b&gt;db.kv.lock&lt;/b&gt;&lt;br&gt;holds the exclusive lock" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffe6cc;fillStyle=solid;strokeColor=#d79b00;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1270" y="1103" width="360" height="58" as="geometry"/></mxCell>
<mxCell id="e0_0" value="commands" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15625;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="cli"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e0_1" value="open / check / dump" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.625;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ver" target="cli"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e0_2" value="HPUT / HBATCH (stdin)" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.12048192771084337;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="serve"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="330"/><mxPoint x="900" y="330"/></Array></mxGeometry></mxCell>
<mxCell id="e0_3" value="ACK / ERR (stdout)" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#2e7d32;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.30120481927710846;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="serve" target="orc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="360"/><mxPoint x="950" y="360"/></Array></mxGeometry></mxCell>
<mxCell id="e0_4" value="SIGKILL" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7228915662650602;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="kill" target="serve"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="385"/><mxPoint x="1400" y="385"/></Array></mxGeometry></mxCell>
<mxCell id="e0_5" value="library calls" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.21604938271604937;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="c_eng"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e0_6" value="library calls" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7253086419753086;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="serve" target="c_eng"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e0_7" value="pwrite / pread" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.2345679012345679;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_eng" target="pc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e0_8" value="fsync ×2 per commit" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.6049382716049383;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_eng" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e0_9" value="flushed by fsync" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pc" target="dbkv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e0_10" value="rename tmp → db.kv" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="tmp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e0_11" value="kernel releases the lock" style="sketch=1;curveFitting=1;jiggle=2;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;strokeColor=#333333;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sig" target="lck"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
