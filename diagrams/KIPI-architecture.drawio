<diagram id="page1" name="2. Low-Level: Write Path &amp; Recovery">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="&lt;b&gt;Low-Level: Write Path (one commit) and Crash Recovery (open)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=24;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1600" height="40" as="geometry"/></mxCell>
<mxCell id="st" value="Red tags are crash points: ./torture --mode crash-points kills the real binary at each one and checks the result shown." style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="24" as="geometry"/></mxCell>
<mxCell id="cw" value="WRITE PATH  ·  db.Apply(ops)  ·  src/kvdb/write.go" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="800" height="1150" as="geometry"/></mxCell>
<mxCell id="w1" value="&lt;b&gt;1. Take the write lock&lt;/b&gt; (one writer at a time)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w2" value="&lt;b&gt;2. Validate&lt;/b&gt;: key 1–1024 B · value ≤ 1 MiB · 1–10,000 ops" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="198" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w3" value="&lt;b&gt;3. Encode&lt;/b&gt; each record: CRC32C · ValLen · KeyLen · Flags · key · value; then a marker (N)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="266" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w4" value="&lt;b&gt;4. Space guard&lt;/b&gt;: file + write ≤ limit?&lt;br&gt;(PUTs keep the last 1/8 free for deletes)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="334" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w5" value="&lt;b&gt;5. pwrite records&lt;/b&gt; at the end of the file, in 256 KiB pieces" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="402" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w6" value="&lt;b&gt;6. fsync #1&lt;/b&gt;: the records are on the disk" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w7" value="&lt;b&gt;7. pwrite commit marker&lt;/b&gt; (12 bytes, ValLen = N records)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="538" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w8" value="&lt;b&gt;8. fsync #2&lt;/b&gt;: marker on disk = COMMITTED" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="606" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w9" value="&lt;b&gt;9. Update RAM index&lt;/b&gt; in listed order (put / delete)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="674" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w10" value="&lt;b&gt;10. ACK&lt;/b&gt;: serve prints ACK from inside the commit, lock still held" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="742" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w11" value="&lt;b&gt;11. Auto-compact?&lt;/b&gt; dead &gt; max(1 MiB, live) or database empty" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="810" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w12" value="&lt;b&gt;12. Unlock&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="878" width="430" height="50" as="geometry"/></mxCell>
<mxCell id="w2e" value="ERR BAD_REQUEST&lt;br&gt;nothing written" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="198" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="w4c" value="room after compacting:&lt;br&gt;compact first, then go on" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="334" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="w4e" value="ERR DISK_FULL: no room even&lt;br&gt;after compaction · 0 bytes written" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="402" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="werr" value="&lt;b&gt;a write or fsync fails&lt;/b&gt; (steps 5–8)&lt;br&gt;cut the file back to its old end; if even that fails, the engine is poisoned and refuses writes" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f5f5f5;fillStyle=solid;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="480" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="w11c" value="Compaction (page 3)&lt;br&gt;same lock, crash-safe" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="810" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="cpl" value="&lt;b&gt;Crash points on this path&lt;/b&gt;  (process dies at … → result after recovery)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;text;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="958" width="740" height="22" as="geometry"/></mxCell>
<mxCell id="cpw0" value="CP1 before the write → op absent" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="988" width="360" height="38" as="geometry"/></mxCell>
<mxCell id="cpw1" value="CP2 between pieces → torn tail, cut" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="445" y="988" width="360" height="38" as="geometry"/></mxCell>
<mxCell id="cpw2" value="CP3 before fsync 1 → no marker, cut" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="1038" width="360" height="38" as="geometry"/></mxCell>
<mxCell id="cpw3" value="CP4 after fsync 1 → no marker, cut" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="445" y="1038" width="360" height="38" as="geometry"/></mxCell>
<mxCell id="cpw4" value="CP5 before fsync 2 → kept (cache survives a kill)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="1088" width="360" height="38" as="geometry"/></mxCell>
<mxCell id="cpw5" value="CP6 committed, no ACK → kept" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="445" y="1088" width="360" height="38" as="geometry"/></mxCell>
<mxCell id="cpw6" value="CP7 after the ACK → kept" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="1138" width="360" height="38" as="geometry"/></mxCell>
<mxCell id="cr" value="CRASH RECOVERY  ·  kvdb.Open(path)  ·  src/kvdb/recovery.go" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="780" height="1150" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;1. Lock db.kv.lock&lt;/b&gt; (flock / LockFileEx)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="130" width="440" height="54" as="geometry"/></mxCell>
<mxCell id="r1e" value="ERR DB_LOCKED&lt;br&gt;another process has it" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="130" width="230" height="54" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;2. db.kv missing?&lt;/b&gt; create it: header → tmp → fsync → rename → dir fsync" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="206" width="440" height="54" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;3. Leftover db.kv.tmp?&lt;/b&gt; delete it (db.kv always wins)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="282" width="440" height="54" as="geometry"/></mxCell>
<mxCell id="r4" value="&lt;b&gt;4. Check the 16-byte header&lt;/b&gt; (&quot;KIPI&quot;, version 1)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="358" width="440" height="54" as="geometry"/></mxCell>
<mxCell id="r4e" value="ERR CORRUPT&lt;br&gt;file not touched" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="358" width="230" height="54" as="geometry"/></mxCell>
<mxCell id="cscan" value="5. SCAN LOOP  (8 MiB buffered read; writes nothing)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffffff;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="434" width="720" height="360" as="geometry"/></mxCell>
<mxCell id="s1" value="read the 12-byte header" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="950" y="474" width="280" height="46" as="geometry"/></mxCell>
<mxCell id="s2" value="lengths within limits? (checked before allocating)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="950" y="540" width="280" height="46" as="geometry"/></mxCell>
<mxCell id="s3" value="read key + value · CRC32C matches?" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="950" y="606" width="280" height="46" as="geometry"/></mxCell>
<mxCell id="s4" value="record type?" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="965" y="672" width="250" height="96" as="geometry"/></mxCell>
<mxCell id="s7" value="&lt;b&gt;STOP&lt;/b&gt; at end of file or at the first record that is short, too long or fails its CRC: that is the torn / uncommitted tail" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="474" width="320" height="112" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;data record (PUT / DEL)&lt;/b&gt;&lt;br&gt;stage it, not applied yet" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="614" width="320" height="54" as="geometry"/></mxCell>
<mxCell id="s6" value="&lt;b&gt;marker with count = staged&lt;/b&gt;&lt;br&gt;apply staged to the index · lastSafe = end" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="694" width="320" height="64" as="geometry"/></mxCell>
<mxCell id="r6" value="&lt;b&gt;6. Corruption guard&lt;/b&gt;: a COMPLETE record failed but a valid marker comes after it?&lt;br&gt;→ damage inside committed data, not a crash: ERR CORRUPT, truncate nothing" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="820" width="720" height="70" as="geometry"/></mxCell>
<mxCell id="r7" value="&lt;b&gt;7. Copy the tail&lt;/b&gt; to db.kv.rejected-* (never applied), then &lt;b&gt;ftruncate(lastSafe)&lt;/b&gt;. A marker missing only its last 1-4 constant bytes is rebuilt instead (F4)" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="915" width="440" height="54" as="geometry"/></mxCell>
<mxCell id="r8" value="&lt;b&gt;8. fsync&lt;/b&gt;: the cut is durable" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#dae8fc;fillStyle=solid;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="993" width="440" height="54" as="geometry"/></mxCell>
<mxCell id="r9" value="&lt;b&gt;9. Ready&lt;/b&gt;: fileSize = lastSafe&lt;br&gt;prints keys, time, accepted, rejected + reason" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="1071" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="cp14" value="CP14 creating, before the rename" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="213" width="230" height="40" as="geometry"/></mxCell>
<mxCell id="cp8" value="CP8 deleting the tmp" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="289" width="230" height="40" as="geometry"/></mxCell>
<mxCell id="cp9" value="CP9 scan done, nothing written" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="922" width="230" height="40" as="geometry"/></mxCell>
<mxCell id="cp10" value="CP10 after ftruncate, before fsync" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#f8cecc;fillStyle=solid;strokeColor=#b85450;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="1000" width="230" height="40" as="geometry"/></mxCell>
<mxCell id="ridem" value="&lt;b&gt;Idempotent&lt;/b&gt;&lt;br&gt;step 7 is the only write to db.kv, and it only shortens it to an already-checked prefix. Kill recovery anywhere: the next open reaches the same state." style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffffff;fillStyle=solid;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1400" y="1071" width="230" height="150" as="geometry"/></mxCell>
