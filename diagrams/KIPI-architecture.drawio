<mxCell id="fex" value="&lt;b&gt;Example&lt;/b&gt;: put name Ada on a new database = 47 bytes&lt;br&gt;4b 49 50 49 01 00 … (header 16) · 6b a5 25 4b | 03 00 00 00 | 04 00 | 05 | 00 | name | Ada (19) · 15 0c 00 58 | 01 00 00 00 | 00 00 | 08 | 00 (marker 12)" style="html=1;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#ffffff;fillStyle=solid;strokeColor=#666666;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="485" width="820" height="100" as="geometry"/></mxCell>
<mxCell id="frule" value="&lt;b&gt;The one rule&lt;/b&gt;: a record counts only if a valid marker follows it whose N equals the records before it. A marker is written only after fsync #1, so a marker on disk proves its records are on disk. Anything after the last valid marker never happened." style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="600" width="820" height="95" as="geometry"/></mxCell>
<mxCell id="cm" value="IN-MEMORY STATE  ·  struct DB  (src/kvdb/db.go)" style="html=1;whiteSpace=wrap;fontSize=14;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=hachure;hachureGap=10;fillWeight=0.5;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="740" width="880" height="360" as="geometry"/></mxCell>
<mxCell id="mi" value="&lt;b&gt;index&lt;/b&gt;  map[string]entry&lt;br&gt;key → entry{ off, recSize, vlen }&lt;br&gt;off = where the record starts in db.kv (dashed arrow)&lt;br&gt;only the latest version of each live key&lt;br&gt;values are NOT in RAM: read with pread, CRC re-checked" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="780" width="400" height="150" as="geometry"/></mxCell>
<mxCell id="mf" value="&lt;b&gt;fileSize&lt;/b&gt; next append offset (= lastSafe)&lt;br&gt;&lt;b&gt;liveBytes&lt;/b&gt; size of live records → dead = file − 16 − live&lt;br&gt;&lt;b&gt;poisoned&lt;/b&gt; set after a failed fsync / rollback&lt;br&gt;&lt;b&gt;opts&lt;/b&gt; MaxBytes · CompactMinBytes · CrashAt" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#fff2cc;fillStyle=solid;strokeColor=#d6b656;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1230" y="780" width="400" height="150" as="geometry"/></mxCell>
<mxCell id="mmu" value="&lt;b&gt;mu&lt;/b&gt;  sync.RWMutex&lt;br&gt;writers: Lock (Apply, Compact)&lt;br&gt;readers: RLock (Get, Dump)&lt;br&gt;a reader never sees half a batch" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="950" width="400" height="130" as="geometry"/></mxCell>
<mxCell id="mlk" value="&lt;b&gt;lock&lt;/b&gt;  *os.File on db.kv.lock&lt;br&gt;exclusive OS lock for the process lifetime&lt;br&gt;second process → DB_LOCKED&lt;br&gt;kernel releases it even after kill -9" style="html=1;whiteSpace=wrap;fontSize=13;fontColor=#1a1a1a;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;sketch=1;curveFitting=1;jiggle=2;rounded=0;fillColor=#d5e8d4;fillStyle=solid;strokeColor=#82b366;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1230" y="950" width="400" height="130" as="geometry"/></mxCell>
